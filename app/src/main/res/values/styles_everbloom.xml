<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos reutilizables de la app (componentes del prototipo) -->
<resources>
    <style name="EbPestana">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="EbPestanaIcono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="EbPestanaTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:textColor">@color/eb_text_light</item>
    </style>
    <style name="EbEtiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/eb_text_light</item>
    </style>
    <style name="EbTarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/tarjeta</item>
        <item name="android:elevation">3dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="EbTituloSerif">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eb_text_dark</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="EbChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/chip_color</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:padding">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="EbChipFoto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
    <style name="EbChipTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eb_text_dark</item>
    </style>
    <style name="EbSatin">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/satin</item>
        <item name="android:elevation">2dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="EbSatinMuestra">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
    </style>
    <style name="EbSatinTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eb_text_dark</item>
    </style>
    <style name="EbFila">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">5dp</item>
    </style>
    <style name="EbFilaNombre">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/eb_text_mid</item>
    </style>
    <style name="EbFilaValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eb_text_dark</item>
    </style>

    <!-- Tema propio de la app: claro, sin barra de título y con la barra de estado coral -->
    <style name="Theme.EverBloomApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/eb_primary</item>
        <item name="colorOnPrimary">@color/eb_white</item>
        <item name="colorSecondary">@color/eb_primary_dark</item>
        <item name="android:statusBarColor">@color/eb_primary_dark</item>
        <item name="android:windowBackground">@color/eb_bg_soft</item>
    </style>
</resources>
